<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude PIN hashes, salts, and brute-force lockout counters from unencrypted cloud auto-backups -->
    <exclude domain="sharedpref" path="Note.xml" />
    <!-- Exclude hardware-bound SQLite database from automatic cloud extraction (use encrypted .purevault instead) -->
    <exclude domain="database" path="notes" />
    <exclude domain="database" path="notes-shm" />
    <exclude domain="database" path="notes-wal" />
</full-backup-content>
