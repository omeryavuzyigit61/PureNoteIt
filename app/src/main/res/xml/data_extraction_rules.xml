<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive PIN hashes/salts and hardware-bound encrypted notes from unencrypted cloud extraction -->
        <exclude domain="sharedpref" path="Note.xml" />
        <exclude domain="root" path="no_backup" />
        <exclude domain="sharedpref" path="purenoteit_tink_token_keyset.xml" />
        <exclude domain="file" path="datastore/purenote_secure_auth.preferences_pb" />
        <exclude domain="file" path="purenote_sqlcipher_keyset.bin" />
        <exclude domain="database" path="notes" />
        <exclude domain="database" path="notes-shm" />
        <exclude domain="database" path="notes-wal" />
        <exclude domain="database" path="notes.plain.bak" />
        <exclude domain="database" path="notes.sqlcipher.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="Note.xml" />
        <exclude domain="root" path="no_backup" />
        <exclude domain="sharedpref" path="purenoteit_tink_token_keyset.xml" />
        <exclude domain="file" path="datastore/purenote_secure_auth.preferences_pb" />
        <exclude domain="file" path="purenote_sqlcipher_keyset.bin" />
        <exclude domain="database" path="notes" />
        <exclude domain="database" path="notes-shm" />
        <exclude domain="database" path="notes-wal" />
        <exclude domain="database" path="notes.plain.bak" />
        <exclude domain="database" path="notes.sqlcipher.tmp" />
    </device-transfer>
</data-extraction-rules>
