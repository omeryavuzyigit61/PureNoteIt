        name="shared_images"
        path="shared_images/" />
    <files-path
        name="shared_sounds"
        path="recordings/" />
    <files-path
        name="shared_drawings"
        path="drawings/" />
    <cache-path
        name="camera_ocr"
        path="camera_ocr/" />
    <cache-path
        name="pdf_exports"
        path="exports/" />
    <cache-path
        name="vault_backups"
        path="backups/" />
</paths>
