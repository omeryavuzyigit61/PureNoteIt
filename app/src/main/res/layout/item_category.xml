<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/noteScreen"
    android:background="@drawable/search_background">

    <TextView
        android:id="@+id/categoryTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"
        android:text=""
        style="@style/TextColor"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/editNameImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/categoryDeleteImageView"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/delete"
        style="@style/allTint"
        app:layout_constraintBottom_toBottomOf="@+id/categoryLockImageView"
        app:layout_constraintEnd_toStartOf="@+id/categoryLockImageView"
        app:layout_constraintTop_toTopOf="@+id/categoryLockImageView"
        app:layout_constraintVertical_bias="1.0" />

    <ImageView
        android:id="@+id/categoryLockImageView"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        style="@style/allTint"
        app:layout_constraintBottom_toBottomOf="@+id/categoryTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/categoryTextView" />

    <ImageView
        android:id="@+id/editNameImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        style="@style/allTint"
        app:layout_constraintBottom_toBottomOf="@+id/categoryDeleteImageView"
        app:layout_constraintEnd_toStartOf="@+id/categoryDeleteImageView"
        app:layout_constraintTop_toTopOf="@+id/categoryDeleteImageView"
        app:srcCompat="@drawable/customize" />
</androidx.constraintlayout.widget.ConstraintLayout>