<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BackgroundScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.AddFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topMenuConstraintLayout"
        style="@style/TopMenuScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/top_menu_background"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/backImageButton">

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="10dp"
            android:checkedButton="@id/noteRadioButton"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/noteRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/custom_radio_background"
                android:button="@null"
                android:checked="true"
                android:drawableEnd="@drawable/radio_button_note_icon"
                android:padding="8dp"
                android:text="Not"
                android:textColor="@color/white" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/diaryRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/custom_radio_background"
                android:button="@null"
                android:drawableEnd="@drawable/radio_button_diary_icon"
                android:padding="8dp"
                android:text="Günlük"
                android:textColor="@color/white" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/importantRadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/custom_radio_background"
                android:button="@null"
                android:drawableEnd="@drawable/radio_button_important_icon"
                android:padding="8dp"
                android:text="Önemli"
                android:textColor="@color/white" />

            <RadioButton
                android:id="@+id/otherRadiButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_weight="0.7"
                android:background="@drawable/custom_radio_background"
                android:button="@null"
                android:padding="8dp"
                android:text="Diğer"
                android:textColor="@color/white" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/categoryLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@+id/radioGroup">

            <include
                android:id="@+id/categorySearchView"
                layout="@layout/panda_search_bar"
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/categoryButton"
                style="@style/ConfirmButton2"
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:background="@drawable/confirm_button_background"
                android:text="Onayla"
                android:textColor="@color/white" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/selectIconButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/white_gray_circle_background"
        android:gravity="center"
        android:text="➕"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/titleEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topMenuConstraintLayout" />

    <EditText
        android:id="@+id/titleEditText"
        style="@style/TextColor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="16dp"
        android:background="@null"
        android:ems="10"
        android:gravity="start|top"
        android:hint="Başlık"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/selectIconButton"
        app:layout_constraintTop_toBottomOf="@+id/topMenuConstraintLayout" />

    <EditText
        android:id="@+id/descriptionEditText"
        style="@style/TextColor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@null"
        android:ems="10"
        android:gravity="start|top"
        android:hint="Yazmaya başla (Notion formatları desteklenir)..."
        android:inputType="textMultiLine"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/soundListRecyclerView" />

    <!-- Notion-Style Quick Formatting Toolbar -->
    <HorizontalScrollView
        android:id="@+id/notionToolbarScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        android:background="@drawable/custom_note_item"
        android:backgroundTint="#F2F2F5"
        android:padding="4dp"
        app:layout_constraintBottom_toTopOf="@+id/confirm_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFormatH1"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:background="@drawable/confirm_button_background"
                android:backgroundTint="@color/white"
                android:text="H1"
                android:textColor="@color/gray"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFormatH2"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:background="@drawable/confirm_button_background"
                android:backgroundTint="@color/white"
                android:text="H2"
                android:textColor="@color/gray"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFormatTodo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/confirm_button_background"
                android:backgroundTint="@color/white"
                android:drawableStart="@drawable/ic_checklist"
                android:drawablePadding="4dp"
                android:drawableTint="@color/orange"
                android:paddingHorizontal="10dp"
                android:text="Görev"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFormatBullet"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/confirm_button_background"
                android:backgroundTint="@color/white"
                android:drawableStart="@drawable/ic_format_bullet"
                android:drawablePadding="4dp"
                android:drawableTint="@color/gray"
                android:paddingHorizontal="10dp"
                android:text="Liste"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFormatQuote"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/confirm_button_background"
                android:backgroundTint="@color/white"
                android:drawableStart="@drawable/ic_format_quote"
                android:drawablePadding="4dp"
                android:drawableTint="@color/gray"
                android:paddingHorizontal="10dp"
                android:text="Alıntı"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFormatDivider"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/confirm_button_background"
                android:backgroundTint="@color/white"
                android:paddingHorizontal="10dp"
                android:text="— Çizgi"
                android:textColor="@color/gray"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/confirm_button"
        style="@style/ConfirmButton"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/confirm_button_background"
        android:paddingStart="16dp"
        android:text="Ekle"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/notionToolbarScrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/imageRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/backImageButton"
        style="@style/allTint"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:src="@drawable/arrow_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/menuImageView"
        style="@style/CornerButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/white_background"
        android:padding="8dp"
        android:src="@drawable/menu"
        app:layout_constraintBottom_toBottomOf="@+id/backImageButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/backImageButton" />

    <View
        android:id="@+id/view"
        style="@style/allBackgroundTint"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="@drawable/confirm_button_background"
        app:layout_constraintBottom_toBottomOf="@+id/confirm_button"
        app:layout_constraintEnd_toEndOf="@+id/confirm_button"
        app:layout_constraintStart_toStartOf="@+id/soundSaveImageView"
        app:layout_constraintTop_toTopOf="@+id/confirm_button" />

    <ImageView
        android:id="@+id/addImageView"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/white_gray_circle_background"
        android:padding="14dp"
        android:src="@drawable/picture"
        app:layout_constraintBottom_toBottomOf="@+id/confirm_button"
        app:layout_constraintEnd_toStartOf="@+id/confirm_button"
        app:layout_constraintTop_toTopOf="@+id/confirm_button"
        app:tint="@color/gray" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="76dp"
        android:background="@drawable/white_background"
        android:elevation="10dp"
        android:src="@drawable/plus_small"
        app:layout_constraintBottom_toBottomOf="@+id/confirm_button"
        app:layout_constraintEnd_toEndOf="@+id/confirm_button"
        app:layout_constraintTop_toTopOf="@+id/confirm_button"
        app:tint="@color/gray" />

    <ImageView
        android:id="@+id/soundImageView"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/white_gray_circle_background"
        android:padding="12dp"
        android:src="@drawable/microphone_lines"
        app:layout_constraintBottom_toBottomOf="@+id/confirm_button"
        app:layout_constraintEnd_toStartOf="@+id/addImageView"
        app:layout_constraintTop_toTopOf="@+id/confirm_button"
        app:layout_constraintVertical_bias="0.0"
        app:tint="@color/gray" />

    <ImageView
        android:id="@+id/securityImageView"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/white_gray_circle_background"
        android:padding="12dp"
        android:src="@drawable/fingerprint"
        app:layout_constraintBottom_toBottomOf="@+id/confirm_button"
        app:layout_constraintEnd_toStartOf="@+id/soundImageView"
        app:layout_constraintTop_toTopOf="@+id/confirm_button"
        app:layout_constraintVertical_bias="0.0"
        app:tint="@color/gray" />

    <ImageView
        android:id="@+id/soundSaveImageView"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/white_gray_circle_background"
        android:padding="12dp"
        android:src="@drawable/waveform_path"
        app:layout_constraintBottom_toBottomOf="@+id/confirm_button"
        app:layout_constraintEnd_toStartOf="@+id/securityImageView"
        app:layout_constraintTop_toTopOf="@+id/confirm_button"
        app:layout_constraintVertical_bias="0.0"
        app:tint="@color/gray" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/soundListRecyclerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/titleEditText"
        app:layout_constraintStart_toStartOf="@+id/selectIconButton"
        app:layout_constraintTop_toBottomOf="@+id/titleEditText" />

    <View
        android:id="@+id/view2"
        style="@style/allBackgroundTint"
        android:layout_width="50dp"
        android:layout_height="0dp"
        android:background="@drawable/confirm_button_background"
        app:layout_constraintBottom_toBottomOf="@+id/confirm_button"
        app:layout_constraintEnd_toEndOf="@+id/shareButton"
        app:layout_constraintStart_toStartOf="@+id/shareButton"
        app:layout_constraintTop_toTopOf="@+id/shareButton" />

    <ImageView
        android:id="@+id/shareButton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/white_gray_circle_background"
        android:padding="12dp"
        android:src="@drawable/share_square"
        android:tint="@color/gray"
        app:layout_constraintBottom_toTopOf="@+id/confirm_button"
        app:layout_constraintEnd_toEndOf="@+id/confirm_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
