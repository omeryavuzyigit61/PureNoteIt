<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PureNoteIt" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorEdgeEffect">@color/orange</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimaryVariant">@color/background_color</item>
    </style>

    <style name="Theme.PureNoteIt" parent="Base.Theme.PureNoteIt" />

    <style name="BackgroundScreen">
        <item name="android:background">@color/background_color
        </item>
    </style>

    <style name="TextColor">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="noteScreen">
        <item name="android:backgroundTint">@color/white
        </item>
    </style>

    <style name="TopMenuScreen">
        <item name="android:backgroundTint">@color/top_menu_background
        </item>
    </style>

    <style name="SearchScreen">
        <item name="android:backgroundTint">@color/white
        </item>
        <item name="android:textColor">@color/black
        </item>
        <item name="drawableTint">@color/gray</item>
    </style>

    <style name="SearchScreen2">
        <item name="android:backgroundTint">@color/white
        </item>
        <item name="android:textColor">@color/black
        </item>
        <item name="drawableTint">@color/gray</item>
    </style>

    <style name="DrawerMenu">
        <item name="itemIconTint">@color/gray</item>
    </style>

    <style name="ConfirmButton">
        <item name="android:backgroundTint">@color/gray</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ConfirmButton2">
        <item name="android:backgroundTint">@color/gray</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CornerButton">
        <item name="android:backgroundTint">@color/white</item>
        <item name="tint">@color/gray</item>
    </style>

    <style name="allTint">
        <item name="tint">@color/gray</item>
    </style>

    <style name="allTintLight">
        <item name="tint">@color/gray</item>
    </style>

    <style name="allBackgroundTint">
        <item name="android:backgroundTint">@color/gray</item>
    </style>

    <style name="NoteCategoryStyle">
        <item name="android:backgroundTint">@color/orange</item>
        <item name="tint">@color/white</item>
    </style>


    <style name="FloatingButtonStyle">
        <item name="backgroundTint">@color/gray</item>
        <item name="tint">@color/white</item>
    </style>

    <style name="CustomDatePickerDialog" parent="Theme.AppCompat.Light.Dialog">
        <!-- Başlık rengi (yukarısı) -->
        <item name="colorAccent">@color/gray</item>

        <!-- Seçilen tarih rengi -->
        <item name="android:textColorPrimary">@color/orange</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/CustomDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/CustomDialogButton</item>
    </style>

    <style name="CustomDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="MyCustomSwitchTheme">
        <!-- active thumb & track color (30% transparency) -->
        <item name="colorControlActivated">@color/orange</item>

        <!-- inactive thumb color -->
        <item name="colorSwitchThumbNormal">@color/gray</item>

        <!-- inactive track color (30% transparency) -->
        <item name="android:colorForeground">#42221f1f</item>
    </style>
</resources>